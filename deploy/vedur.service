[Unit]
Description=Vedur (gunicorn)
After=network.target

[Service]
WorkingDirectory=/srv/vedur

EnvironmentFile=/etc/default/vedur

ExecStart=/srv/vedur/.venv/bin/gunicorn --chdir /srv/vedur --workers 2 --bind 127.0.0.1:8019 wsgi:app

# User/group and restarts
User=web
Group=www-data
Restart=on-failure
RestartSec=2

# Ensure logs go to the journal
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
